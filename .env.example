# ==============================================================================
# Configuración de Entorno - API Detección Visual
# ==============================================================================
# Renombrar este archivo a ".env" e ingresar los valores correspondientes
# ¡NUNCA comitear el archivo .env real con contraseñas al repositorio!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=usuario_bd
POSTGRES_PASSWORD=password_seguro_bd
POSTGRES_DB=nombre_bd
DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. Interfaz de Gestión de BD (pgAdmin)
# ------------------------------------------------------------------------------
PGADMIN_EMAIL=admin@tudominio.com
PGADMIN_PASSWORD=password_seguro_pgadmin

# ------------------------------------------------------------------------------
# 3. Almacenamiento de Objetos (SeaweedFS)
# ------------------------------------------------------------------------------
# Puertos internos de los contenedores
SEAWEED_MASTER_PORT=9333
SEAWEED_VOLUME_PORT=8080
# NOTA: En docker-compose.local.yml, el puerto del volumen se mapea al host 
# en el 8090 para evitar conflictos con otras apps (como Label Studio).

# ------------------------------------------------------------------------------
# 3b. Inference Server - URL para persistencia facial (callback a la API)
# ------------------------------------------------------------------------------
# En VM usa http://api:8000 (default). En local usar: https://bfts2026.mooo.com
API_URL=https://bfts2026.mooo.com

# ------------------------------------------------------------------------------
# 4. Keycloak (Autenticacion OAuth2/OIDC)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_REALM=api-detection
# URL interna del contenedor Keycloak (no cambiar)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# ------------------------------------------------------------------------------
# 5. Monitoreo (InfluxDB + Grafana)
# ------------------------------------------------------------------------------
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin123
INFLUXDB_TOKEN=soa-token
INFLUXDB_ORG=soa
INFLUXDB_BUCKET=metrics
INFLUXDB_RETENTION=30d
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123
HOSTNAME=api-detection-local

# ------------------------------------------------------------------------------
# 6. API Backend (FastAPI)
# ------------------------------------------------------------------------------
API_PORT=8000

# ------------------------------------------------------------------------------
# 7. Inference Server (YOLO) - URL para inferencia interna (orquestador)
# ------------------------------------------------------------------------------
# Cuando la API recibe una imagen sin detecciones pre-calculadas, llama a esta
# URL para ejecutar YOLO. En Docker compose, apunta al servicio inference-server.
# En desarrollo local sin Docker, apuntar a http://localhost:8001
INFERENCE_SERVER_URL=http://inference-server:8000